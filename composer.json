{
    "name": "dwivedianuj/laravel-a11y",
    "description": "Find WCAG accessibility issues in Laravel apps and get the exact Blade, Livewire, Filament or Inertia file:line to fix.",
    "keywords": ["laravel", "accessibility", "a11y", "wcag", "axe-core", "blade", "livewire", "filament", "inertia"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anuj Dwivedi",
            "email": "dwivedianuj9118@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/process": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "DwivediAnuj\\A11y\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DwivediAnuj\\A11y\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DwivediAnuj\\A11y\\A11yServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
